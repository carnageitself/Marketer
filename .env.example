# All optional for local use: with nothing set, the app runs on an embedded
# Postgres in ./.data and serves everything from http://localhost:3000.

# Any Postgres (Supabase, Neon, RDS…). Tables are created automatically on first request.
DATABASE_URL=

# Secret mixed into the daily anonymous visitor hash. Set a long random value in production.
ANALYTICS_SALT=

# Public URL of this app, used in the snippet customers paste (e.g. https://app.pagewise.io).
APP_URL=

# First-party tracking: the hostname customers' t.<their-domain> CNAME points to
# (e.g. cname.pagewise.io, which itself points at your hosting).
CNAME_TARGET=

# On Vercel: lets the app add each customer subdomain to this project so it gets HTTPS automatically.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# "Sign in with Cloudflare" for DNS records and the zero-code Worker install.
# Create a client at dash.cloudflare.com → Manage account → OAuth clients with
# redirect URI <APP_URL>/api/connect/cloudflare/callback. It starts private (only
# your account can use it); make it public once your domain is verified.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Must match the client's scopes (list ids: GET https://api.cloudflare.com/client/v4/oauth/scopes).
CLOUDFLARE_OAUTH_SCOPES=

# Domain Connect: customers sign in at GoDaddy, IONOS, Vercel, NameSilo… and approve
# the records. Generate these with: node scripts/domain-connect.mjs <domain> <app-host> [cname-target]
DOMAIN_CONNECT_PROVIDER_ID=
DOMAIN_CONNECT_SERVICE_ID=
DOMAIN_CONNECT_KEY_ID=
DOMAIN_CONNECT_PRIVATE_KEY=
